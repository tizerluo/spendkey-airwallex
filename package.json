{
  "name": "spendkey-airwallex",
  "description": "Spendkey for Cards: intent-bound purchase agent enforced by Airwallex card controls",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm build && tsc --noEmit && pnpm -r typecheck",
    "lint": "eslint .",
    "verify": "bash scripts/check-secrets.sh && pnpm typecheck && pnpm lint && pnpm test",
    "demo:offline": "pnpm build && node packages/app/dist/demo/cli.js offline",
    "demo:sandbox": "pnpm build && node packages/app/dist/demo/cli.js sandbox",
    "console": "pnpm build && node packages/app/dist/server/cli.js",
    "console:offline": "pnpm build && node packages/app/dist/server/offline-cli.js",
    "audit:verify": "pnpm --filter @sk/ledger build && node scripts/audit-verify.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.1",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "3.2.4"
  }
}
