{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "http://json-schema.org/draft-07/schema#",
  "info": {
    "title": "spendkey API",
    "version": "1.0.0",
    "description": "v1.0.0 frozen after the Opus K1 blocking fixes; see docs/adr/0001-schema-v1.md."
  },
  "externalDocs": {
    "description": "Public decision chain discovery endpoint",
    "url": "./decision-chain.openapi.json"
  },
  "paths": {
    "/v1/plan": {
      "post": {
        "operationId": "createPlan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed payment plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentPlan"
                }
              }
            }
          }
        }
      }
    },
    "/v1/guard": {
      "post": {
        "operationId": "guardPayment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuardReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Guard decision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuardResult"
                }
              }
            }
          }
        }
      }
    },
    "/v1/quote": {
      "post": {
        "operationId": "getQuote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "$ref": "#/components/schemas/HttpUrl"
                  }
                },
                "required": [
                  "url"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Candidate native x402 v1 or v2 quotes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Quote"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/catalog": {
      "get": {
        "operationId": "getCatalog",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "celo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Catalog entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/receipts": {
      "post": {
        "operationId": "reportReceipt",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Receipt"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded payment receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          }
        }
      }
    },
    "/v1/stats": {
      "get": {
        "operationId": "getStats",
        "responses": {
          "200": {
            "description": "Aggregate metrics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          }
        }
      }
    },
    "/v1/plans/{id}/approve": {
      "post": {
        "operationId": "approvePlan",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Identifier"
            }
          }
        ],
        "description": "Approve the identified plan; returns the resulting signed plan. Authentication is defined by the API implementation.",
        "responses": {
          "200": {
            "description": "Approved payment plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentPlan"
                }
              }
            }
          }
        }
      }
    },
    "/v1/audit/{id}": {
      "get": {
        "operationId": "getAuditRecord",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Identifier"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditRecord"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Action": {
        "type": "string",
        "enum": [
          "pay",
          "refuse",
          "ask"
        ]
      },
      "Address": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      },
      "Approval": {
        "type": "object",
        "properties": {
          "required": {
            "type": "boolean"
          },
          "approveUrl": {
            "$ref": "#/components/schemas/HttpsUrl"
          }
        },
        "required": [
          "required",
          "approveUrl"
        ],
        "additionalProperties": false
      },
      "AtomicAmount": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "Attribution": {
        "type": "object",
        "properties": {
          "erc8021": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[\\x20-\\x7E]+$(?![\\s\\S])"
            },
            "minItems": 1
          }
        },
        "required": [
          "erc8021"
        ],
        "additionalProperties": false
      },
      "AuditRecord": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Identifier"
              },
              "planId": {
                "$ref": "#/components/schemas/Identifier"
              },
              "budgetKey": {
                "$ref": "#/components/schemas/Identifier"
              },
              "seq": {
                "type": "integer",
                "minimum": 0
              },
              "payer": {
                "$ref": "#/components/schemas/Address"
              },
              "timestamp": {
                "$ref": "#/components/schemas/Timestamp"
              },
              "hash": {
                "$ref": "#/components/schemas/Hash"
              },
              "prevHash": {
                "$ref": "#/components/schemas/Hash"
              },
              "stateHash": {
                "$ref": "#/components/schemas/Hash"
              },
              "kind": {
                "type": "string",
                "const": "plan"
              },
              "decision": {
                "$ref": "#/components/schemas/Decision"
              },
              "decider": {
                "$ref": "#/components/schemas/Decider"
              },
              "rules": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Identifier"
                }
              },
              "savedAmountAtomic": {
                "$ref": "#/components/schemas/AtomicAmount"
              }
            },
            "required": [
              "id",
              "planId",
              "budgetKey",
              "seq",
              "payer",
              "timestamp",
              "hash",
              "prevHash",
              "kind",
              "decision",
              "decider",
              "rules",
              "savedAmountAtomic"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Identifier"
              },
              "planId": {
                "$ref": "#/components/schemas/Identifier"
              },
              "budgetKey": {
                "$ref": "#/components/schemas/Identifier"
              },
              "seq": {
                "type": "integer",
                "minimum": 0
              },
              "payer": {
                "$ref": "#/components/schemas/Address"
              },
              "timestamp": {
                "$ref": "#/components/schemas/Timestamp"
              },
              "hash": {
                "$ref": "#/components/schemas/Hash"
              },
              "prevHash": {
                "$ref": "#/components/schemas/Hash"
              },
              "stateHash": {
                "$ref": "#/components/schemas/Hash"
              },
              "kind": {
                "type": "string",
                "const": "guard"
              },
              "decision": {
                "$ref": "#/components/schemas/Decision"
              },
              "decider": {
                "$ref": "#/components/schemas/Decider"
              },
              "rules": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Identifier"
                }
              },
              "savedAmountAtomic": {
                "$ref": "#/components/schemas/AtomicAmount"
              }
            },
            "required": [
              "id",
              "planId",
              "budgetKey",
              "seq",
              "payer",
              "timestamp",
              "hash",
              "prevHash",
              "kind",
              "decision",
              "decider",
              "rules",
              "savedAmountAtomic"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Identifier"
              },
              "planId": {
                "$ref": "#/components/schemas/Identifier"
              },
              "budgetKey": {
                "$ref": "#/components/schemas/Identifier"
              },
              "seq": {
                "type": "integer",
                "minimum": 0
              },
              "payer": {
                "$ref": "#/components/schemas/Address"
              },
              "timestamp": {
                "$ref": "#/components/schemas/Timestamp"
              },
              "hash": {
                "$ref": "#/components/schemas/Hash"
              },
              "prevHash": {
                "$ref": "#/components/schemas/Hash"
              },
              "stateHash": {
                "$ref": "#/components/schemas/Hash"
              },
              "kind": {
                "type": "string",
                "const": "receipt"
              },
              "receipt": {
                "$ref": "#/components/schemas/Receipt"
              }
            },
            "required": [
              "id",
              "planId",
              "budgetKey",
              "seq",
              "payer",
              "timestamp",
              "hash",
              "prevHash",
              "kind",
              "receipt"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/components/schemas/Identifier"
              },
              "planId": {
                "$ref": "#/components/schemas/Identifier"
              },
              "budgetKey": {
                "$ref": "#/components/schemas/Identifier"
              },
              "seq": {
                "type": "integer",
                "minimum": 0
              },
              "payer": {
                "$ref": "#/components/schemas/Address"
              },
              "timestamp": {
                "$ref": "#/components/schemas/Timestamp"
              },
              "hash": {
                "$ref": "#/components/schemas/Hash"
              },
              "prevHash": {
                "$ref": "#/components/schemas/Hash"
              },
              "stateHash": {
                "$ref": "#/components/schemas/Hash"
              },
              "kind": {
                "type": "string",
                "const": "approval"
              },
              "decision": {
                "$ref": "#/components/schemas/Decision"
              },
              "decider": {
                "$ref": "#/components/schemas/Decider"
              },
              "rules": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Identifier"
                }
              },
              "savedAmountAtomic": {
                "$ref": "#/components/schemas/AtomicAmount"
              }
            },
            "required": [
              "id",
              "planId",
              "budgetKey",
              "seq",
              "payer",
              "timestamp",
              "hash",
              "prevHash",
              "kind",
              "decision",
              "decider",
              "rules",
              "savedAmountAtomic"
            ],
            "additionalProperties": false
          }
        ]
      },
      "CallSpec": {
        "type": "object",
        "properties": {
          "url": {
            "$ref": "#/components/schemas/HttpsUrl"
          },
          "method": {
            "$ref": "#/components/schemas/HttpMethod"
          },
          "body": {},
          "bodyHash": {
            "$ref": "#/components/schemas/Hash"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "toolId": {
            "$ref": "#/components/schemas/Identifier"
          }
        },
        "required": [
          "url",
          "method",
          "source",
          "toolId"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "body"
              ]
            },
            "then": {
              "required": [
                "bodyHash"
              ]
            }
          }
        ]
      },
      "CatalogItem": {
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "url": {
            "$ref": "#/components/schemas/HttpUrl"
          },
          "method": {
            "$ref": "#/components/schemas/HttpMethod"
          },
          "name": {
            "$ref": "#/components/schemas/Identifier"
          },
          "description": {
            "type": "string"
          },
          "inputSchema": {
            "type": "object",
            "additionalProperties": {}
          },
          "x402Version": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              }
            ]
          },
          "celoAssets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Identifier"
            }
          },
          "price": {
            "$ref": "#/components/schemas/CatalogPrice"
          },
          "payRail": {
            "type": "string",
            "enum": [
              "x402",
              "prepaid",
              "card"
            ]
          },
          "celo": {
            "type": "boolean"
          },
          "scoreable": {
            "type": "boolean"
          },
          "trust": {
            "type": "object",
            "properties": {
              "erc8004": {
                "$ref": "#/components/schemas/Identifier"
              },
              "payers30d": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "requiresSelf": {
            "type": "boolean"
          },
          "async": {
            "type": "boolean"
          },
          "updatedAt": {
            "$ref": "#/components/schemas/Timestamp"
          }
        },
        "required": [
          "source",
          "id",
          "url",
          "method",
          "x402Version",
          "celoAssets",
          "price",
          "payRail",
          "celo",
          "scoreable",
          "requiresSelf",
          "async"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "price": {
                  "properties": {
                    "network": {
                      "const": "eip155:42220"
                    }
                  },
                  "required": [
                    "network"
                  ]
                }
              },
              "required": [
                "price"
              ]
            },
            "then": {
              "properties": {
                "celo": {
                  "const": true
                }
              }
            },
            "else": {
              "properties": {
                "celo": {
                  "const": false
                },
                "scoreable": {
                  "const": false
                }
              }
            }
          }
        ]
      },
      "CatalogPrice": {
        "type": "object",
        "properties": {
          "amountAtomic": {
            "$ref": "#/components/schemas/AtomicAmount"
          },
          "asset": {
            "$ref": "#/components/schemas/Address"
          },
          "network": {
            "type": "string",
            "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$"
          }
        },
        "required": [
          "amountAtomic",
          "asset",
          "network"
        ],
        "additionalProperties": false
      },
      "Decider": {
        "type": "object",
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/DecisionProviderId"
          },
          "model": {
            "$ref": "#/components/schemas/Identifier"
          },
          "transport": {
            "type": "string",
            "enum": [
              "systemone",
              "openai-decisions",
              "chat-json",
              "rules"
            ]
          },
          "probs": {
            "$ref": "#/components/schemas/Probs"
          },
          "confidence": {
            "$ref": "#/components/schemas/Probability"
          },
          "fallback": {
            "type": "boolean"
          }
        },
        "required": [
          "provider",
          "model",
          "transport",
          "probs",
          "fallback"
        ],
        "additionalProperties": false
      },
      "Decision": {
        "type": "object",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "reasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Identifier"
            }
          },
          "probs": {
            "$ref": "#/components/schemas/Probs"
          }
        },
        "required": [
          "action",
          "reasons",
          "probs"
        ],
        "additionalProperties": false
      },
      "DecisionChain": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DecisionProviderId"
            },
            "minItems": 1,
            "maxItems": 7
          },
          "note": {
            "type": "string",
            "const": "Configured order. Providers without credentials on this deployment are skipped; rules always runs last."
          }
        },
        "required": [
          "chain",
          "note"
        ],
        "additionalProperties": false
      },
      "DecisionProviderId": {
        "type": "string",
        "pattern": "^(?:rules|typesafe:[A-Za-z0-9._-]+|openrouter:[a-z0-9-]+\\/[A-Za-z0-9._-]+(?::free)?|fastino:[a-z0-9-]+\\/[A-Za-z0-9._-]+)$"
      },
      "GuardQuote": {
        "type": "object",
        "properties": {
          "amountAtomic": {
            "$ref": "#/components/schemas/AtomicAmount"
          },
          "asset": {
            "$ref": "#/components/schemas/Address"
          },
          "network": {
            "$ref": "#/components/schemas/Network"
          },
          "payTo": {
            "$ref": "#/components/schemas/Address"
          }
        },
        "required": [
          "amountAtomic",
          "asset",
          "network",
          "payTo"
        ],
        "additionalProperties": false
      },
      "GuardReq": {
        "type": "object",
        "properties": {
          "url": {
            "$ref": "#/components/schemas/HttpsUrl"
          },
          "quote": {
            "$ref": "#/components/schemas/GuardQuote"
          },
          "intent": {
            "$ref": "#/components/schemas/Identifier"
          },
          "maxSpend": {
            "$ref": "#/components/schemas/SpendAmount"
          },
          "payer": {
            "$ref": "#/components/schemas/Address"
          }
        },
        "required": [
          "url",
          "quote",
          "intent",
          "maxSpend",
          "payer"
        ],
        "additionalProperties": false
      },
      "GuardResult": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "expiresAt": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "reasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Identifier"
            }
          },
          "maxAmountAtomic": {
            "$ref": "#/components/schemas/AtomicAmount"
          },
          "decider": {
            "$ref": "#/components/schemas/Decider"
          },
          "auditHash": {
            "$ref": "#/components/schemas/Hash"
          },
          "prevHash": {
            "$ref": "#/components/schemas/Hash"
          }
        },
        "required": [
          "id",
          "expiresAt",
          "action",
          "reasons",
          "maxAmountAtomic",
          "decider",
          "auditHash",
          "prevHash"
        ],
        "additionalProperties": false
      },
      "Hash": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{64}$"
      },
      "HttpMethod": {
        "type": "string",
        "enum": [
          "GET",
          "POST",
          "PUT",
          "PATCH",
          "DELETE",
          "HEAD",
          "OPTIONS"
        ]
      },
      "HttpsUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^[hH][tT][tT][pP][sS]://"
      },
      "HttpUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^[hH][tT][tT][pP][sS]?://"
      },
      "Identifier": {
        "type": "string",
        "minLength": 1
      },
      "Network": {
        "type": "string",
        "const": "eip155:42220"
      },
      "PaymentPlan": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "payer": {
            "$ref": "#/components/schemas/Address"
          },
          "nonce": {
            "$ref": "#/components/schemas/Hash"
          },
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "reasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Identifier"
            }
          },
          "decider": {
            "$ref": "#/components/schemas/Decider"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanStep"
            },
            "minItems": 1,
            "maxItems": 10
          },
          "approval": {
            "$ref": "#/components/schemas/Approval"
          },
          "attribution": {
            "$ref": "#/components/schemas/Attribution"
          },
          "expiresAt": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "auditHash": {
            "$ref": "#/components/schemas/Hash"
          },
          "prevHash": {
            "$ref": "#/components/schemas/Hash"
          },
          "sig": {
            "$ref": "#/components/schemas/Signature"
          }
        },
        "required": [
          "id",
          "payer",
          "nonce",
          "action",
          "reasons",
          "decider",
          "attribution",
          "expiresAt",
          "auditHash",
          "prevHash",
          "sig"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "pay"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "steps"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "steps"
                ]
              }
            }
          },
          {
