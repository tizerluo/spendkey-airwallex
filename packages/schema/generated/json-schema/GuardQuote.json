{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sr:schema:1.0.0:GuardQuote",
  "title": "GuardQuote",
  "type": "object",
  "properties": {
    "amountAtomic": {
      "$ref": "#/definitions/AtomicAmount"
    },
    "asset": {
      "$ref": "#/definitions/Address"
    },
    "network": {
      "$ref": "#/definitions/Network"
    },
    "payTo": {
      "$ref": "#/definitions/Address"
    }
  },
  "required": [
    "amountAtomic",
    "asset",
    "network",
    "payTo"
  ],
  "additionalProperties": false,
  "definitions": {
    "AtomicAmount": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "Address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "Network": {
      "type": "string",
      "const": "eip155:42220"
    }
  }
}
