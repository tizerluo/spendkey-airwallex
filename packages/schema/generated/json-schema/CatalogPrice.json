{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sr:schema:1.0.0:CatalogPrice",
  "title": "CatalogPrice",
  "type": "object",
  "properties": {
    "amountAtomic": {
      "$ref": "#/definitions/AtomicAmount"
    },
    "asset": {
      "$ref": "#/definitions/Address"
    },
    "network": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$"
    }
  },
  "required": [
    "amountAtomic",
    "asset",
    "network"
  ],
  "additionalProperties": false,
  "definitions": {
    "AtomicAmount": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "Address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    }
  }
}
