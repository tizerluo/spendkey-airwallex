{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sr:schema:1.0.0:GuardReq",
  "title": "GuardReq",
  "type": "object",
  "properties": {
    "url": {
      "$ref": "#/definitions/HttpsUrl"
    },
    "quote": {
      "$ref": "#/definitions/GuardQuote"
    },
    "intent": {
      "$ref": "#/definitions/Identifier"
    },
    "maxSpend": {
      "$ref": "#/definitions/SpendAmount"
    },
    "payer": {
      "$ref": "#/definitions/Address"
    }
  },
  "required": [
    "url",
    "quote",
    "intent",
    "maxSpend",
    "payer"
  ],
  "additionalProperties": false,
  "definitions": {
    "HttpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^[hH][tT][tT][pP][sS]://"
    },
    "GuardQuote": {
      "type": "object",
      "properties": {
        "amountAtomic": {
          "$ref": "#/definitions/AtomicAmount"
        },
        "asset": {
          "$ref": "#/definitions/Address"
        },
        "network": {
          "$ref": "#/definitions/Network"
        },
        "payTo": {
          "$ref": "#/definitions/Address"
        }
      },
      "required": [
        "amountAtomic",
        "asset",
        "network",
        "payTo"
      ],
      "additionalProperties": false
    },
    "Identifier": {
      "type": "string",
      "minLength": 1
    },
    "SpendAmount": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "Address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "AtomicAmount": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "Network": {
      "type": "string",
      "const": "eip155:42220"
    }
  }
}
