{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sr:schema:1.0.0:Receipt",
  "title": "Receipt",
  "type": "object",
  "properties": {
    "planId": {
      "$ref": "#/definitions/Identifier"
    },
    "tx": {
      "$ref": "#/definitions/Hash"
    },
    "network": {
      "type": "string",
      "const": "eip155:42220"
    }
  },
  "required": [
    "planId",
    "tx",
    "network"
  ],
  "additionalProperties": false,
  "definitions": {
    "Identifier": {
      "type": "string",
      "minLength": 1
    },
    "Hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    }
  }
}
