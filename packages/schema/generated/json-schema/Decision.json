{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sr:schema:1.0.0:Decision",
  "title": "Decision",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/definitions/Action"
    },
    "reasons": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Identifier"
      }
    },
    "probs": {
      "$ref": "#/definitions/Probs"
    }
  },
  "required": [
    "action",
    "reasons",
    "probs"
  ],
  "additionalProperties": false,
  "definitions": {
    "Action": {
      "type": "string",
      "enum": [
        "pay",
        "refuse",
        "ask"
      ]
    },
    "Identifier": {
      "type": "string",
      "minLength": 1
    },
    "Probs": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/definitions/Probability"
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/Probability"
            }
          }
        ]
      }
    },
    "Probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
