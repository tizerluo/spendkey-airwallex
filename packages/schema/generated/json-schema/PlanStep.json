{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sr:schema:1.0.0:PlanStep",
  "title": "PlanStep",
  "type": "object",
  "properties": {
    "call": {
      "$ref": "#/definitions/CallSpec"
    },
    "pay": {
      "$ref": "#/definitions/PaymentSpec"
    },
    "fallbackOf": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    }
  },
  "required": [
    "call",
    "pay"
  ],
  "additionalProperties": false,
  "definitions": {
    "CallSpec": {
      "type": "object",
      "properties": {
        "url": {
          "$ref": "#/definitions/HttpsUrl"
        },
        "method": {
          "$ref": "#/definitions/HttpMethod"
        },
        "body": {},
        "bodyHash": {
          "$ref": "#/definitions/Hash"
        },
        "source": {
          "$ref": "#/definitions/Source"
        },
        "toolId": {
          "$ref": "#/definitions/Identifier"
        }
      },
      "required": [
        "url",
        "method",
        "source",
        "toolId"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "body"
            ]
          },
          "then": {
            "required": [
              "bodyHash"
            ]
          }
        }
      ]
    },
    "PaymentSpec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "x402Version": {
              "type": "number",
              "const": 1
            },
            "network": {
              "type": "string",
              "const": "celo"
            },
            "asset": {
              "$ref": "#/definitions/Address"
            },
            "payTo": {
              "$ref": "#/definitions/Address"
            },
            "maxAmountAtomic": {
              "$ref": "#/definitions/AtomicAmount"
            },
            "scoreable": {
              "type": "boolean"
            }
          },
          "required": [
            "x402Version",
            "network",
            "asset",
            "payTo",
            "maxAmountAtomic",
            "scoreable"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "x402Version": {
              "type": "number",
              "const": 2
            },
            "network": {
              "type": "string",
              "const": "eip155:42220"
            },
            "asset": {
              "$ref": "#/definitions/Address"
            },
            "payTo": {
              "$ref": "#/definitions/Address"
            },
            "maxAmountAtomic": {
              "$ref": "#/definitions/AtomicAmount"
            },
            "scoreable": {
              "type": "boolean"
            }
          },
          "required": [
            "x402Version",
            "network",
            "asset",
            "payTo",
            "maxAmountAtomic",
            "scoreable"
          ],
          "additionalProperties": false
        }
      ]
    },
    "HttpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^[hH][tT][tT][pP][sS]://"
    },
    "HttpMethod": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS"
      ]
    },
    "Hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "Source": {
      "type": "string",
      "enum": [
        "buy",
        "agent402",
        "bazaar"
      ]
    },
    "Identifier": {
      "type": "string",
      "minLength": 1
    },
    "Address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "AtomicAmount": {
      "type": "string",
      "pattern": "^[0-9]+$"
    }
  }
}
