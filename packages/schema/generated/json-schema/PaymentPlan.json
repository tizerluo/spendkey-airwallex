{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sr:schema:1.0.0:PaymentPlan",
  "title": "PaymentPlan",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/definitions/Identifier"
    },
    "payer": {
      "$ref": "#/definitions/Address"
    },
    "nonce": {
      "$ref": "#/definitions/Hash"
    },
    "action": {
      "$ref": "#/definitions/Action"
    },
    "reasons": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Identifier"
      }
    },
    "decider": {
      "$ref": "#/definitions/Decider"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PlanStep"
      },
      "minItems": 1,
      "maxItems": 10
    },
    "approval": {
      "$ref": "#/definitions/Approval"
    },
    "attribution": {
      "$ref": "#/definitions/Attribution"
    },
    "expiresAt": {
      "$ref": "#/definitions/Timestamp"
    },
    "auditHash": {
      "$ref": "#/definitions/Hash"
    },
    "prevHash": {
      "$ref": "#/definitions/Hash"
    },
    "sig": {
      "$ref": "#/definitions/Signature"
    }
  },
  "required": [
    "id",
    "payer",
    "nonce",
    "action",
    "reasons",
    "decider",
    "attribution",
    "expiresAt",
    "auditHash",
    "prevHash",
    "sig"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "pay"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "steps"
        ]
      },
      "else": {
        "not": {
          "required": [
            "steps"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "ask"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "approval"
        ],
        "properties": {
          "approval": {
            "properties": {
              "required": {
                "const": true
              }
            },
            "required": [
              "required"
            ]
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "approval"
          ]
        }
      }
    },
    {
      "properties": {
        "steps": {
          "items": [
            {
              "properties": {
                "fallbackOf": false
              }
            },
            {
              "properties": {
                "fallbackOf": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 0
                }
              }
            },
            {
              "properties": {
                "fallbackOf": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            {
              "properties": {
                "fallbackOf": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2
                }
              }
            },
            {
              "properties": {
                "fallbackOf": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                }
              }
            },
            {
              "properties": {
                "fallbackOf": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4
                }
              }
            },
            {
              "properties": {
                "fallbackOf": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                }
              }
            },
            {
              "properties": {
                "fallbackOf": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                }
              }
            },
            {
              "properties": {
                "fallbackOf": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 7
                }
              }
            },
            {
              "properties": {
                "fallbackOf": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8
                }
              }
            }
          ]
        }
      }
    }
  ],
  "definitions": {
    "Identifier": {
      "type": "string",
      "minLength": 1
    },
    "Address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "Action": {
      "type": "string",
      "enum": [
        "pay",
        "refuse",
        "ask"
      ]
    },
    "Decider": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/definitions/DecisionProviderId"
        },
        "model": {
          "$ref": "#/definitions/Identifier"
        },
        "transport": {
          "type": "string",
          "enum": [
            "systemone",
            "openai-decisions",
            "chat-json",
            "rules"
          ]
        },
        "probs": {
          "$ref": "#/definitions/Probs"
        },
        "confidence": {
          "$ref": "#/definitions/Probability"
        },
        "fallback": {
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "model",
        "transport",
        "probs",
        "fallback"
      ],
      "additionalProperties": false
    },
    "PlanStep": {
      "type": "object",
      "properties": {
        "call": {
          "$ref": "#/definitions/CallSpec"
        },
        "pay": {
          "$ref": "#/definitions/PaymentSpec"
        },
        "fallbackOf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      },
      "required": [
        "call",
        "pay"
      ],
      "additionalProperties": false
    },
    "Approval": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "approveUrl": {
          "$ref": "#/definitions/HttpsUrl"
        }
      },
      "required": [
        "required",
        "approveUrl"
      ],
      "additionalProperties": false
    },
    "Attribution": {
      "type": "object",
      "properties": {
        "erc8021": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[\\x20-\\x7E]+$(?![\\s\\S])"
          },
          "minItems": 1
        }
      },
      "required": [
        "erc8021"
      ],
      "additionalProperties": false
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^((\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-((0[13578]|1[02])-(0[1-9]|[12]\\d|3[01])|(0[469]|11)-(0[1-9]|[12]\\d|30)|(02)-(0[1-9]|1\\d|2[0-8])))T([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d(\\.\\d+)?)?(Z|([+-]\\d{2}:?\\d{2}))$"
    },
    "Signature": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{130}$"
    },
    "DecisionProviderId": {
      "type": "string",
      "pattern": "^(?:rules|typesafe:[A-Za-z0-9._-]+|openrouter:[a-z0-9-]+\\/[A-Za-z0-9._-]+(?::free)?|fastino:[a-z0-9-]+\\/[A-Za-z0-9._-]+)$"
    },
    "Probs": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/definitions/Probability"
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/Probability"
            }
          }
        ]
      }
    },
    "Probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "CallSpec": {
      "type": "object",
      "properties": {
        "url": {
          "$ref": "#/definitions/HttpsUrl"
        },
        "method": {
          "$ref": "#/definitions/HttpMethod"
        },
        "body": {},
        "bodyHash": {
          "$ref": "#/definitions/Hash"
        },
        "source": {
          "$ref": "#/definitions/Source"
        },
        "toolId": {
          "$ref": "#/definitions/Identifier"
        }
      },
      "required": [
        "url",
        "method",
        "source",
        "toolId"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "body"
            ]
          },
          "then": {
            "required": [
              "bodyHash"
            ]
          }
        }
      ]
    },
    "PaymentSpec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "x402Version": {
              "type": "number",
              "const": 1
            },
            "network": {
              "type": "string",
              "const": "celo"
            },
            "asset": {
              "$ref": "#/definitions/Address"
            },
            "payTo": {
              "$ref": "#/definitions/Address"
            },
            "maxAmountAtomic": {
              "$ref": "#/definitions/AtomicAmount"
            },
            "scoreable": {
              "type": "boolean"
            }
          },
          "required": [
            "x402Version",
            "network",
            "asset",
            "payTo",
            "maxAmountAtomic",
            "scoreable"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "x402Version": {
              "type": "number",
              "const": 2
            },
            "network": {
              "type": "string",
              "const": "eip155:42220"
            },
            "asset": {
              "$ref": "#/definitions/Address"
            },
            "payTo": {
              "$ref": "#/definitions/Address"
            },
            "maxAmountAtomic": {
              "$ref": "#/definitions/AtomicAmount"
            },
            "scoreable": {
              "type": "boolean"
            }
          },
          "required": [
            "x402Version",
            "network",
            "asset",
            "payTo",
            "maxAmountAtomic",
            "scoreable"
          ],
          "additionalProperties": false
        }
      ]
    },
    "HttpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^[hH][tT][tT][pP][sS]://"
    },
    "HttpMethod": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS"
      ]
    },
    "Source": {
      "type": "string",
      "enum": [
        "buy",
        "agent402",
        "bazaar"
      ]
    },
    "AtomicAmount": {
      "type": "string",
      "pattern": "^[0-9]+$"
    }
  }
}
