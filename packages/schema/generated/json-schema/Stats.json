{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sr:schema:1.0.0:Stats",
  "title": "Stats",
  "type": "object",
  "properties": {
    "uniquePayers": {
      "type": "integer",
      "minimum": 0
    },
    "plans": {
      "type": "integer",
      "minimum": 0
    },
    "executionRate": {
      "$ref": "#/definitions/Probability"
    },
    "refusalRate": {
      "$ref": "#/definitions/Probability"
    },
    "savedAmountAtomic": {
      "$ref": "#/definitions/AtomicAmount"
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ProviderStats"
      }
    },
    "updatedAt": {
      "$ref": "#/definitions/Timestamp"
    }
  },
  "required": [
    "uniquePayers",
    "plans",
    "executionRate",
    "refusalRate",
    "savedAmountAtomic",
    "providers",
    "updatedAt"
  ],
  "additionalProperties": false,
  "definitions": {
    "Probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "AtomicAmount": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "ProviderStats": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/definitions/DecisionProviderId"
        },
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0
        },
        "fallbackRate": {
          "$ref": "#/definitions/Probability"
        }
      },
      "required": [
        "provider",
        "calls",
        "latencyMs",
        "fallbackRate"
      ],
      "additionalProperties": false
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^((\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-((0[13578]|1[02])-(0[1-9]|[12]\\d|3[01])|(0[469]|11)-(0[1-9]|[12]\\d|30)|(02)-(0[1-9]|1\\d|2[0-8])))T([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d(\\.\\d+)?)?(Z|([+-]\\d{2}:?\\d{2}))$"
    },
    "DecisionProviderId": {
      "type": "string",
      "pattern": "^(?:rules|typesafe:[A-Za-z0-9._-]+|openrouter:[a-z0-9-]+\\/[A-Za-z0-9._-]+(?::free)?|fastino:[a-z0-9-]+\\/[A-Za-z0-9._-]+)$"
    }
  }
}
