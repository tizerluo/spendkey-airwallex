{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sr:schema:1.0.0:PaymentSpec",
  "title": "PaymentSpec",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "x402Version": {
          "type": "number",
          "const": 1
        },
        "network": {
          "type": "string",
          "const": "celo"
        },
        "asset": {
          "$ref": "#/definitions/Address"
        },
        "payTo": {
          "$ref": "#/definitions/Address"
        },
        "maxAmountAtomic": {
          "$ref": "#/definitions/AtomicAmount"
        },
        "scoreable": {
          "type": "boolean"
        }
      },
      "required": [
        "x402Version",
        "network",
        "asset",
        "payTo",
        "maxAmountAtomic",
        "scoreable"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "x402Version": {
          "type": "number",
          "const": 2
        },
        "network": {
          "type": "string",
          "const": "eip155:42220"
        },
        "asset": {
          "$ref": "#/definitions/Address"
        },
        "payTo": {
          "$ref": "#/definitions/Address"
        },
        "maxAmountAtomic": {
          "$ref": "#/definitions/AtomicAmount"
        },
        "scoreable": {
          "type": "boolean"
        }
      },
      "required": [
        "x402Version",
        "network",
        "asset",
        "payTo",
        "maxAmountAtomic",
        "scoreable"
      ],
      "additionalProperties": false
    }
  ],
  "definitions": {
    "Address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "AtomicAmount": {
      "type": "string",
      "pattern": "^[0-9]+$"
    }
  }
}
