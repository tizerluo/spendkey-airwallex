{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sr:schema:1.0.0:Decider",
  "title": "Decider",
  "type": "object",
  "properties": {
    "provider": {
      "$ref": "#/definitions/DecisionProviderId"
    },
    "model": {
      "$ref": "#/definitions/Identifier"
    },
    "transport": {
      "type": "string",
      "enum": [
        "systemone",
        "openai-decisions",
        "chat-json",
        "rules"
      ]
    },
    "probs": {
      "$ref": "#/definitions/Probs"
    },
    "confidence": {
      "$ref": "#/definitions/Probability"
    },
    "fallback": {
      "type": "boolean"
    }
  },
  "required": [
    "provider",
    "model",
    "transport",
    "probs",
    "fallback"
  ],
  "additionalProperties": false,
  "definitions": {
    "DecisionProviderId": {
      "type": "string",
      "pattern": "^(?:rules|typesafe:[A-Za-z0-9._-]+|openrouter:[a-z0-9-]+\\/[A-Za-z0-9._-]+(?::free)?|fastino:[a-z0-9-]+\\/[A-Za-z0-9._-]+)$"
    },
    "Identifier": {
      "type": "string",
      "minLength": 1
    },
    "Probs": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/definitions/Probability"
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/Probability"
            }
          }
        ]
      }
    },
    "Probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
