{
  "name": "@sk/app",
  "version": "0.0.0",
  "private": true,
  "description": "Server-rendered Spendkey console views for approval, audit, and the approval index",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm --filter @sk/agent... build && vitest run",
    "typecheck": "pnpm --filter @sk/ledger build && pnpm --filter @sk/policy build && tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@sr/core": "workspace:*",
    "@sk/ledger": "workspace:*",
    "@sk/policy": "workspace:*",
    "@sk/airwallex": "workspace:*",
    "@sk/agent": "workspace:*",
    "@sk/offers": "workspace:*",
    "zod": "3.25.76"
  }
}
