{
  "name": "@sk/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm --filter @sk/policy... build && pnpm --filter @sk/compare... build && pnpm --filter @sk/ledger... build && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@sk/offers": "workspace:*",
    "@sk/compare": "workspace:*",
    "@sk/policy": "workspace:*",
    "@sk/ledger": "workspace:*"
  }
}
